{
  "expo": {
    "name": "知酷课程表",
    "slug": "college-schedule",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zhiku",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-lockup.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jiujiu380.collegeschedule"
    },
    "android": {
      "package": "com.jiujiu380.collegeschedule",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./plugins/withTimetableWidget",
      [
        "./plugins/withAndroidBuildSpeed"
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2F5BFF",
          "defaultChannel": "class-reminders"
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于获取你所在位置的天气，仅在本机使用。"
        }
      ]
    ]
  }
}
